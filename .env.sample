# WebSocket Chat and Signaling Server Configuration

# Server bind address (IP address to bind the server to)
SERVER_BIND_ADDRESS=127.0.0.1

# Server port (port number for the WebSocket server)
SERVER_PORT=8080

# Maximum concurrent connections (limit to prevent resource exhaustion)
MAX_CONNECTIONS=1000

# Log level (trace, debug, info, warn, error)
# - trace: Most verbose, includes all debug info and function entry/exit
# - debug: Detailed information for debugging, includes connection details
# - info: General information about server operations (default)
# - warn: Warning messages about potential issues
# - error: Only error messages
LOG_LEVEL=trace

# Optional: Override Rust's built-in logging with RUST_LOG environment variable
# RUST_LOG=websocket_chat_signaling_server=debug